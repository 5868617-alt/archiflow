# ArchiFlow – configuration reference. Nothing here is read at build time by a framework;
# the live site has its Supabase URL and publishable key in src/live/config.ts.

# --- Public (safe in the browser – data is protected by RLS, not by hiding these)
SUPABASE_URL=https://qbwaqngxdgmqgddxcuzv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_e44fG20gwT2_GPrICJGDKA_170V2Xxu

# --- Never in the browser, never committed
# SUPABASE_SERVICE_ROLE_KEY=   (Dashboard → Settings → API keys; only for future server-side webhooks)

# --- Edge Function secrets (Dashboard → Edge Functions → Secrets)
# RESEND_API_KEY=re_...       without it, send-emails sends nothing and e-mails stay queued
# EMAIL_FROM="ArchiFlow <notifications@your-domain.co.il>"   (or Vault secret archiflow_email_from)
# APP_URL=https://<your-site>.vercel.app                       (or Vault secret archiflow_app_url)
